{
    "name": "market-bot",
    "type": "module",
    "private": true,
    "author": "Jeroen Akkerman",
    "version": "3.0.0",
    "description": "A Discord bot for looking up EVE Online market prices",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ionaru/MarketBot.git"
    },
    "scripts": {
        "clean": "npx rimraf -q dist",
        "build": "npm run clean && tsc --skipLibCheck --project tsconfig.json",
        "check": "tsc --noEmit --skipLibCheck --project tsconfig.json && prettier --check . && eslint src && echo 👌",
        "format": "prettier --write . && eslint --fix src && echo 👌",
        "pretest": "npm run lint",
        "test": "jest src",
        "start": "bun run src/index.ts",
        "start:ts": "TS_NODE_FILES=true node --require ts-node/register src/index.ts"
    },
    "jest": {
        "collectCoverage": true,
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/**/*.d.ts",
            "!src/**/*.spec.ts",
            "!dist/**/*"
        ],
        "preset": "ts-jest",
        "testEnvironment": "node"
    },
    "dependencies": {
        "@bugsnag/js": "^7.5.4",
        "@ionaru/array-utils": "^7.0.0",
        "@ionaru/configurator": "^3.0.0",
        "@ionaru/esi-service": "^6.1.0",
        "@ionaru/eve-utils": "^8.0.0",
        "@ionaru/format-number": "^4.0.1",
        "agentkeepalive": "^4.1.3",
        "axios": "^0.26.0",
        "countdown": "^2.6.0",
        "d3": "^5.16.0",
        "d3-node": "^2.2.2",
        "debug": "^4.3.1",
        "discord.js": "^13.3.1",
        "dotenv": "^16.0.0",
        "elastic-apm-node": "^3.9.0",
        "escape-string-regexp": "^4.0.0",
        "fuse.js": "^6.4.6",
        "http-status-codes": "^2.1.4",
        "moment": "^2.29.1",
        "puppeteer": "^13.4.0",
        "reflect-metadata": "^0.1.13",
        "slash-create": "^5.4.1",
        "sqlite3": "^5.0.0",
        "typeorm": "^0.3.20",
        "typescript": "^5.5.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.1.0",
        "@eslint/js": "^9.6.0",
        "@types/bun": "^1.1.6",
        "@types/countdown": "^0.0.8",
        "@types/d3": "^5.16.3",
        "@types/debug": "^4.1.5",
        "@types/eslint__js": "^8.42.3",
        "@types/jest": "^27.0.2",
        "@types/puppeteer": "^5.4.2",
        "@types/sqlite3": "^3.1.6",
        "@typescript-eslint/eslint-plugin": "^5.3.0",
        "eslint": "^9.6.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jest": "^26.1.1",
        "eslint-plugin-no-null": "^1.0.2",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-sonarjs": "^1.0.3",
        "eslint-plugin-unicorn": "^54.0.0",
        "jest": "^27.3.1",
        "prettier": "^3.3.2",
        "ts-jest": "^27.0.7",
        "ts-node": "^10.4.0",
        "typescript-eslint": "^7.14.1"
    },
    "license": "MIT"
}
