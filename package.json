{
    "name": "market-bot",
    "private": true,
    "author": "Jeroen Akkerman",
    "version": "3.0.0",
    "description": "A Discord bot for looking up EVE Online market prices",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ionaru/MarketBot.git"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && tsc --skipLibCheck --project tsconfig.json",
        "lint": "npm run lint:src && npm run lint:test",
        "lint:src": "eslint --ext ts --max-warnings 0 --ignore-pattern *.spec.ts src",
        "lint:test": "eslint --ext ts --plugin jest --env jest/globals src/**/*.spec.ts",
        "pretest": "npm run lint",
        "test": "jest src",
        "start": "npm run build && node dist/src/index.js",
        "start:ts": "TS_NODE_FILES=true node --require ts-node/register src/index.ts"
    },
    "jest": {
        "collectCoverage": true,
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/**/*.d.ts",
            "!src/**/*.spec.ts",
            "!dist/**/*"
        ],
        "preset": "ts-jest",
        "testEnvironment": "node"
    },
    "dependencies": {
        "@bugsnag/js": "^8.10.0",
        "@ionaru/configurator": "^4.0.0",
        "@ionaru/esi-service": "^6.1.0",
        "@ionaru/eve-utils": "^8.0.0",
        "@ionaru/format-number": "^5.0.0",
        "agentkeepalive": "^4.6.0",
        "axios": "^1.19.0",
        "countdown": "^2.6.0",
        "d3": "^7.9.0",
        "d3-node": "^4.0.2",
        "debug": "^4.4.3",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "elastic-apm-node": "^4.18.0",
        "escape-string-regexp": "^4.0.0",
        "fuse.js": "^7.5.0",
        "http-status-codes": "^2.3.0",
        "moment": "^2.30.1",
        "puppeteer": "^25.8.0",
        "reflect-metadata": "^0.2.2",
        "slash-create": "^7.0.0",
        "sqlite3": "^6.0.1",
        "typeorm": "^0.3.31"
    },
    "devDependencies": {
        "@ionaru/eslint-config": "^13.5.0",
        "@types/countdown": "^0.0.12",
        "@types/d3": "^7.4.3",
        "@types/debug": "^4.1.13",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "eslint": "^8.57.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^28.14.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-sonarjs": "^0.24.0",
        "eslint-plugin-unicorn": "^51.0.1",
        "jest": "^30.4.2",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3"
    },
    "overrides": {
        "@ionaru/esi-service": {
            "axios": "1"
        },
        "http-proxy-agent": "^5.0.0"
    },
    "license": "MIT"
}
